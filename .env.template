# API Keys
GEMINI_API_KEY=your_api_key_here

# Server Configuration
PORT=3003
NODE_ENV=development

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Cache
CACHE_TTL=300
CACHE_MAX=100

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=1194714082

# Logging
LOG_LEVEL=debug
LOG_FILE_ENABLED=true
LOG_DIR=logs
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m

# CORS
CORS_ORIGIN=true

# Encryption
ENCRYPTION_SECRET=your_encryption_secret_here
ENCRYPTION_ALGORITHM=AES
ENCRYPTION_ENCODING=base64

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# Auth
AUTH_SALT_ROUNDS=10

# Security
SESSION_SECRET=your_session_secret_here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CSRF_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# Fluentd
FLUENTD_ENABLED=true
FLUENTD_HOST=localhost
FLUENTD_PORT=24224
FLUENTD_TIMEOUT=3.0
FLUENTD_RECONNECT_INTERVAL=600000
